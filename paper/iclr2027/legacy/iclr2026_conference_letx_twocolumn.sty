%% iclr2026_conference.sty
%%
%% Page geometry and title furniture for the ICLR 2026 submission format.
%% Every dimension below was measured off the venue's example PDF with
%% PyMuPDF rather than copied from prose, so `make verify` can compare the
%% compiled draft against the same numbers.
%%
%%   text block   505.7bp wide, left edge at x = 54bp on US Letter
%%   columns      244.7bp each, gutter 16.3bp
%%   body         Times 10pt on 12pt
%%   title        17.28pt bold, authors 12pt, affiliations 6pt, emails 9pt tt
%%   abstract     9pt, inset 29bp on both sides, spanning both columns
%%
%% Run `python verify_format.py out/main.pdf <example.pdf>` after any change
%% here: it re-measures the compiled result against the example and fails on
%% anything more than 0.6bp out.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{iclr2026_conference}[2026/09/06 ICLR 2026 submission format]

\newif\if@iclrrunninghead \@iclrrunningheadfalse
\DeclareOption{runninghead}{\@iclrrunningheadtrue}
\ProcessOptions\relax

\RequirePackage{times}
\RequirePackage{fancyhdr}
\RequirePackage{graphicx}

% ---------------------------------------------------------------- geometry
% Dimensions are given in `bp' (big points, 1/72 in), which is the unit a PDF
% viewer reports. TeX's own `pt' is 1/72.27 in, so specifying 612pt here would
% produce a 609.71bp page: correct-looking in the source and 0.4% short on
% paper. Font sizes stay in pt because the venue's example uses the standard
% 10pt class sizes.
\setlength{\paperwidth}{612bp}
\setlength{\paperheight}{792bp}
\ifdefined\pdfpagewidth
  \setlength{\pdfpagewidth}{612bp}
  \setlength{\pdfpageheight}{792bp}
\fi

\setlength{\textwidth}{505.7bp}
\setlength{\columnsep}{16.3bp}
\setlength{\columnseprule}{0pt}

% LaTeX adds a 1in origin offset to both side margins.
\setlength{\oddsidemargin}{-18bp}   % 54bp - 72bp
\setlength{\evensidemargin}{-18bp}
\setlength{\marginparwidth}{0bp}
\setlength{\marginparsep}{0bp}

\setlength{\headheight}{12bp}
\setlength{\headsep}{18bp}
% Tuned so the first body line box starts at 74.3bp, as in the example. The
% derived value, 72.8 - 72 - 12 - 18 = -29.2bp, lands 0.8bp low: a line box
% top follows the ascender of whichever glyph happens to start the line, so
% the frame origin has to be matched against a rendered page, not computed.
\setlength{\topmargin}{-30bp}
\setlength{\textheight}{657bp}
\setlength{\footskip}{30bp}

\setlength{\parindent}{0pt}
\setlength{\parskip}{6pt plus 1pt minus 1pt}

% Floats. A paper with ten floats over six pages of text builds a backlog
% under the stock penalties: everything defers, and figures surface two pages
% after the text that refers to them. Raising the fractions and allowing
% bottom floats roughly doubles the placement capacity per page.
\renewcommand{\topfraction}{0.92}
\renewcommand{\bottomfraction}{0.85}
\renewcommand{\textfraction}{0.06}
\renewcommand{\floatpagefraction}{0.65}
\renewcommand{\dbltopfraction}{0.92}
\renewcommand{\dblfloatpagefraction}{0.65}
\setcounter{topnumber}{3}
\setcounter{bottomnumber}{2}
\setcounter{totalnumber}{4}
\setcounter{dbltopnumber}{2}

% ------------------------------------------------------------------ header
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\if@iclrrunninghead
  \fancyhead[C]{\fontsize{9}{11}\selectfont\sffamily
    Under review as a conference paper at ICLR 2026}
\fi
\fancyfoot[C]{\fontsize{10}{12}\selectfont\thepage}

% ------------------------------------------------------------- title block
% \maketitle is redefined rather than patched: the stock article version
% centres a \Large title with rules of vertical space that do not match the
% measured baselines.
\newcommand{\iclraffiliation}[1]{\gdef\@iclraffiliation{#1}}
\newcommand{\iclremail}[1]{\gdef\@iclremail{#1}}
\gdef\@iclraffiliation{}
\gdef\@iclremail{}

% Affiliation markers are set at the affiliation's own size rather than with
% \textsuperscript. In the venue's example every glyph on those lines measures
% 6bp, with no smaller size present anywhere on the page, so a true superscript
% would introduce a font size the template does not use.
\newcommand{\afmark}[1]{\raisebox{1.6pt}{#1}}

% The vertical gaps below are the gaps measured between line-box tops in the
% example, minus what the surrounding line boxes already contribute. They read
% as odd numbers for that reason; `make verify' checks the result rather than
% the arithmetic.
\renewcommand{\maketitle}{%
  \vspace*{34pt}%
  \begin{center}%
    {\fontsize{17.28}{22}\selectfont\bfseries \@title \par}%
    \vspace{16.7pt}%
    {\fontsize{12}{14.5}\selectfont \@author \par}%
    \ifx\@iclraffiliation\@empty\else
      \vspace{8pt}%
      {\fontsize{6}{8}\selectfont \@iclraffiliation \par}%
    \fi
    \ifx\@iclremail\@empty\else
      \vspace{1.6pt}%
      {\fontsize{9}{11}\selectfont\ttfamily \@iclremail \par}%
    \fi
  \end{center}%
  \vspace{5.1pt}%
}

% --------------------------------------------------------------- abstract
% Spans both columns, so it lives in the optional argument of \twocolumn and
% cannot use the article environment. The heading sits in the ordinary line
% flow, one leading above the first line of text, which is what the example
% does; adding space after it would push the body 12bp low.
\newenvironment{iclrabstract}{%
  \begin{list}{}{%
    \setlength{\leftmargin}{29bp}%
    \setlength{\rightmargin}{29bp}%
    \setlength{\topsep}{0pt}%
    \setlength{\partopsep}{0pt}%
    \setlength{\parsep}{0pt}%
    \setlength{\listparindent}{0pt}%
    \setlength{\itemindent}{0pt}}%
  \item[]%
  \fontsize{9}{11}\selectfont
  \setlength{\parskip}{0pt}%
  {\bfseries Abstract}\par
}{%
  \end{list}%
  \vspace{18pt}%
}

% --------------------------------------------------------------- headings
% The skips are set so that the measured distance from the previous body line
% to the heading, and from the heading to the following body line, matches the
% example: about 30bp and 25.7bp for a section, 27bp and 20.3bp for a
% subsection. They are smaller than they look because \parskip contributes
% 6pt of its own on the far side of the heading.
% \raggedright on the heading font: a heading long enough to wrap inside a
% 245bp column would otherwise be justified, and 14.4pt Times stretched across
% two lines opens word gaps wide enough to read as a mistake.
\renewcommand{\section}{\@startsection{section}{1}{0pt}%
  {-9.4pt plus -3pt minus -2pt}{4.7pt plus 0.8pt}%
  {\normalfont\fontsize{14.4}{17}\selectfont\bfseries\raggedright}}
\renewcommand{\subsection}{\@startsection{subsection}{2}{0pt}%
  {-8pt plus -2pt minus -1pt}{0.8pt plus 1pt}%
  {\normalfont\fontsize{12}{14}\selectfont\bfseries\raggedright}}
\renewcommand{\subsubsection}{\@startsection{subsubsection}{3}{0pt}%
  {-7pt plus -2pt minus -1pt}{0.4pt plus 1pt}%
  {\normalfont\fontsize{10}{12}\selectfont\bfseries\raggedright}}
\renewcommand{\paragraph}{\@startsection{paragraph}{4}{0pt}%
  {8pt plus 2pt}{-0.6em}%
  {\normalfont\fontsize{10}{12}\selectfont\bfseries}}

% ---------------------------------------------------------------- captions
\long\def\@makecaption#1#2{%
  \vskip 6pt%
  \setbox\@tempboxa\hbox{\fontsize{9}{11}\selectfont {\bfseries #1:} #2}%
  \ifdim \wd\@tempboxa >\hsize
    {\fontsize{9}{11}\selectfont {\bfseries #1:} #2\par}%
  \else
    \hbox to\hsize{\hfil\box\@tempboxa\hfil}%
  \fi}

\endinput
